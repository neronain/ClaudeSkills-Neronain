{
  "_comment": "Reference settings.json for ClaudeSkills-Neronain. Replace YOUR_HOME with your home directory path (e.g. /Users/yourname).",
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "CLAUDE_FLOW_V3_ENABLED": "true"
  },
  "permissions": {
    "allow": [
      "Bash(rtk git *)",
      "Bash(rtk npm *)",
      "Bash(rtk pnpm *)",
      "Bash(rtk docker *)",
      "Bash(rtk kubectl *)",
      "Bash(rtk gh *)",
      "Bash(rtk find *)",
      "Bash(rtk gain *)",
      "Bash(rtk ls *)",
      "Read(//YOUR_HOME/.claude/**)",
      "Read(//YOUR_HOME/claude/**)",
      "WebFetch()",
      "WebSearch()"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "YOUR_HOME/.claude/hooks/rtk-rewrite.sh"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "YOUR_HOME/.claude/statusline.sh"
  },
  "enabledPlugins": {
    "ruflo-core@ruflo": true,
    "ruflo-swarm@ruflo": true,
    "ruflo-autopilot@ruflo": true,
    "ruflo-intelligence@ruflo": true,
    "ruflo-security-audit@ruflo": true,
    "ruflo-testgen@ruflo": true,
    "ruflo-docs@ruflo": true,
    "claude-code-settings@feiskyer/claude-code-settings": true
  },
  "extraKnownMarketplaces": {
    "ruflo": {
      "source": {
        "source": "directory",
        "path": "YOUR_HOME/.claude/ruflo"
      },
      "autoUpdate": false
    },
    "neronain/ClaudeSkills-Neronain": {
      "source": {
        "source": "directory",
        "path": "YOUR_HOME/claude/ClaudeSkills-Neronain"
      },
      "autoUpdate": false
    }
  },
  "mcpServers": {
    "github": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-github"],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "your-github-token-here"
      }
    },
    "postgres": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-postgres"],
      "env": {
        "DATABASE_URL": "postgresql://localhost:5432/mydb?user=postgres"
      }
    },
    "exa": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-exa"],
      "env": {
        "EXA_API_KEY": "your-exa-key-here"
      }
    },
    "perplexity": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-perplexity"],
      "env": {
        "PERPLEXITY_API_KEY": "your-perplexity-key-here"
      }
    },
    "notion": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-notion"],
      "env": {
        "NOTION_API_KEY": "your-notion-api-key-here"
      }
    },
    "slack": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-slack"],
      "env": {
        "SLACK_BOT_TOKEN": "your-slack-bot-token-here"
      }
    },
    "google-maps": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-google-maps"],
      "env": {
        "GOOGLE_API_KEY": "your-google-maps-api-key-here"
      }
    },
    "google-search": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-google-search"],
      "env": {
        "GOOGLE_API_KEY": "your-google-api-key-here",
        "GOOGLE_CSE_ID": "your-google-cse-id-here"
      }
    }
  },
  "skipDangerousModePermissionPrompt": true,
  "theme": "dark",
  "editorMode": "normal"
}
